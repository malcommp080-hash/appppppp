<?xml version="1.0" encoding="utf-8"?>
<!--
  Estilos reutilizables de las vistas. Equivalen a las clases CSS del panel web:
  .ptitle, .card, .fc, .btn, .badge, .sc, etc. Cambia un estilo aquí y cambia en todas las pantallas.
-->
<resources>

    <!-- Contenedor de cada pantalla (dentro del ScrollView) -->
    <style name="Contenido">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">16dp</item>
    </style>

    <!-- .ptitle / .psub -->
    <style name="Titulo">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/texto</item>
        <item name="android:textSize">21sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Subtitulo">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:layout_marginBottom">16dp</item>
        <item name="android:textColor">@color/texto_suave</item>
        <item name="android:textSize">12.5sp</item>
    </style>

    <!-- .card / .fcard -->
    <style name="Tarjeta">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:background">@drawable/fondo_tarjeta</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">14dp</item>
    </style>

    <style name="TarjetaTitulo">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/texto</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TarjetaTexto">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textColor">@color/texto_suave</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- Monto en verde -->
    <style name="Monto">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/exito</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Cabecera de tarjeta con icono (.ch-ttl / .tcard-ttl) -->
    <style name="SeccionTitulo">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="android:textColor">@color/texto</item>
        <item name="android:textSize">13.5sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- .fg label / .fc -->
    <style name="Etiqueta">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">5dp</item>
        <item name="android:textColor">@color/texto_suave</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Campo">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">46dp</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="android:background">@drawable/fondo_input</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textColor">@color/texto</item>
        <item name="android:textColorHint">@color/placeholder</item>
        <item name="android:textSize">14sp</item>
        <item name="android:importantForAutofill">no</item>
    </style>

    <!-- Campo que simula un <select>: muestra una flecha -->
    <style name="Selector" parent="Campo">
        <item name="android:gravity">center_vertical</item>
        <item name="android:drawableEnd">@android:drawable/arrow_down_float</item>
        <item name="android:drawableTint">@color/texto_suave</item>
    </style>

    <!-- .btn-primary / .btn-success / .btn-danger / .btn-orange / .btn-outline -->
    <style name="Boton" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:backgroundTint">@color/primario</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <style name="Boton.Exito">
        <item name="android:backgroundTint">@color/exito</item>
    </style>

    <style name="Boton.Peligro">
        <item name="android:backgroundTint">@color/peligro</item>
    </style>

    <style name="Boton.Naranja">
        <item name="android:backgroundTint">@color/aviso</item>
    </style>

    <style name="BotonContorno" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:textColor">@color/texto</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="strokeColor">@color/borde</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <!-- Botón chico de la barra superior y de las tablas (.btn-sm) -->
    <style name="BotonChico" parent="BotonContorno">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">38dp</item>
        <item name="android:layout_marginTop">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- Iconos de editar / eliminar (.ib-edit / .ib-del) -->
    <style name="Icono">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:padding">8dp</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- .badge -->
    <style name="Badge">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">9dp</item>
        <item name="android:paddingEnd">9dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Badge.Verde">
        <item name="android:background">@drawable/badge_verde</item>
        <item name="android:textColor">@color/exito</item>
    </style>

    <style name="Badge.Naranja">
        <item name="android:background">@drawable/badge_naranja</item>
        <item name="android:textColor">@color/aviso</item>
    </style>

    <style name="Badge.Azul">
        <item name="android:background">@drawable/badge_azul</item>
        <item name="android:textColor">@color/primario</item>
    </style>

    <style name="Badge.Rojo">
        <item name="android:background">@drawable/badge_rojo</item>
        <item name="android:textColor">@color/peligro</item>
    </style>

    <!-- Botones de filtro (.ch-btn / .ch-btn.act) -->
    <style name="Chip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:background">@drawable/fondo_chip</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">7dp</item>
        <item name="android:paddingBottom">7dp</item>
        <item name="android:textColor">@color/texto_suave</item>
        <item name="android:textSize">12.5sp</item>
    </style>

    <style name="Chip.Activo">
        <item name="android:background">@drawable/fondo_chip_activo</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <!-- Tarjeta de estadística (.sc) -->
    <style name="Estadistica">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minHeight">110dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">16dp</item>
    </style>

    <style name="EstadisticaValor">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:maxLines">1</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeMinTextSize">14sp</item>
    </style>

    <style name="EstadisticaEtiqueta">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:textColor">#E6FFFFFF</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="EstadisticaMas">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:textColor">#D9FFFFFF</item>
        <item name="android:textSize">11sp</item>
    </style>

    <!-- Tabla (.tcard th / td) -->
    <style name="TablaEncabezado">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:padding">10dp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/texto_suave</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TablaCelda">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:padding">10dp</item>
        <item name="android:textColor">@color/texto</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="TablaRenglon">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/fondo_renglon</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <!-- Menú lateral (.sb-lbl / .ni) -->
    <style name="MenuSeccion">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">5dp</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/texto_suave</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="MenuOpcion">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:drawablePadding">12dp</item>
        <item name="android:textColor">@color/texto_suave</item>
        <item name="android:textSize">14sp</item>
    </style>

</resources>
