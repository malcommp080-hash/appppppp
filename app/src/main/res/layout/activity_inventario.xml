<?xml version="1.0" encoding="utf-8"?>
<!-- INVENTARIO: stock por talla; el primer producto se muestra abierto para ajustar -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:orientation="vertical"
    tools:context=".Inventario"
    tools:ignore="HardcodedText">

    <include layout="@layout/barra_superior" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout style="@style/Contenido">

            <TextView style="@style/Titulo" android:text="Inventario" />
            <TextView style="@style/Subtitulo" android:text="Stock por talla; toca un producto para ajustarlo" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <LinearLayout style="@style/Estadistica" android:layout_marginEnd="6dp" android:background="@drawable/sc_teal">
                    <TextView style="@style/EstadisticaValor" android:text="7" />
                    <TextView style="@style/EstadisticaEtiqueta" android:text="Productos" />
                </LinearLayout>
                <LinearLayout style="@style/Estadistica" android:layout_marginStart="6dp" android:background="@drawable/sc_green">
                    <TextView style="@style/EstadisticaValor" android:text="133" />
                    <TextView style="@style/EstadisticaEtiqueta" android:text="Piezas en stock" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:layout_marginBottom="16dp" android:orientation="horizontal">
                <LinearLayout style="@style/Estadistica" android:layout_marginEnd="6dp" android:background="@drawable/sc_amber">
                    <TextView style="@style/EstadisticaValor" android:text="$35,325.00" />
                    <TextView style="@style/EstadisticaEtiqueta" android:text="Valor del inventario" />
                </LinearLayout>
                <LinearLayout style="@style/Estadistica" android:layout_marginStart="6dp" android:background="@drawable/sc_red">
                    <TextView style="@style/EstadisticaValor" android:text="4" />
                    <TextView style="@style/EstadisticaEtiqueta" android:text="Con stock bajo (&lt; 5)" />
                </LinearLayout>
            </LinearLayout>

            <EditText style="@style/Campo" android:drawableStart="@android:drawable/ic_menu_search" android:drawablePadding="8dp" android:drawableTint="@color/texto_suave" android:hint="Buscar producto" android:inputType="text" />

            <!-- Producto abierto para ajustar el stock -->
            <LinearLayout style="@style/Tarjeta">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:layout_width="56dp" android:layout_height="56dp" android:background="@drawable/fondo_foto" android:gravity="center" android:text="👖" android:textSize="20sp" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView style="@style/TarjetaTitulo" android:text="Jeans slim" />
                        <TextView style="@style/TarjetaTexto" android:text="Pantalones · Caballero · $349.00" />
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal">
                            <TextView style="@style/Badge.Rojo" android:layout_marginEnd="4dp" android:text="30: 2" />
                            <TextView style="@style/Badge.Rojo" android:text="32: 4" />
                        </LinearLayout>
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="6" android:textColor="@color/peligro" android:textSize="20sp" android:textStyle="bold" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="12dp" android:layout_marginBottom="12dp" android:background="@color/borde" />

                <TextView style="@style/Etiqueta" android:text="Ajustar piezas por talla" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:orientation="horizontal">
                    <LinearLayout android:layout_width="72dp" android:layout_height="wrap_content" android:layout_marginEnd="8dp" android:orientation="vertical">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="4dp" android:gravity="center" android:text="30" android:textColor="@color/texto" android:textStyle="bold" />
                        <EditText style="@style/Campo" android:layout_marginBottom="0dp" android:gravity="center" android:inputType="number" android:text="2" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="72dp" android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="4dp" android:gravity="center" android:text="32" android:textColor="@color/texto" android:textStyle="bold" />
                        <EditText style="@style/Campo" android:layout_marginBottom="0dp" android:gravity="center" android:inputType="number" android:text="4" />
                    </LinearLayout>
                </LinearLayout>
                <com.google.android.material.button.MaterialButton android:id="@+id/btnGuardarStock" style="@style/Boton" android:text="💾  Guardar stock" />
            </LinearLayout>

            <LinearLayout style="@style/Tarjeta">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <ImageView android:layout_width="56dp" android:layout_height="56dp" android:background="@drawable/fondo_foto" android:clipToOutline="true" android:contentDescription="Vestido infantil" android:scaleType="centerCrop" app:srcCompat="@drawable/prod_nina" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView style="@style/TarjetaTitulo" android:text="Vestido infantil" />
                        <TextView style="@style/TarjetaTexto" android:text="Playeras · Niña · $259.00" />
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal">
                            <TextView style="@style/Badge.Azul" android:layout_marginEnd="4dp" android:text="4: 5" />
                            <TextView style="@style/Badge.Azul" android:layout_marginEnd="4dp" android:text="6: 7" />
                            <TextView style="@style/Badge.Rojo" android:text="8: 2" />
                        </LinearLayout>
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="14" android:textColor="@color/peligro" android:textSize="20sp" android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout style="@style/Tarjeta">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <ImageView android:layout_width="56dp" android:layout_height="56dp" android:background="@drawable/fondo_foto" android:clipToOutline="true" android:contentDescription="Blusa casual" android:scaleType="centerCrop" app:srcCompat="@drawable/prod_dama" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView style="@style/TarjetaTitulo" android:text="Blusa casual" />
                        <TextView style="@style/TarjetaTexto" android:text="Playeras · Dama · $229.00" />
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal">
                            <TextView style="@style/Badge.Rojo" android:layout_marginEnd="4dp" android:text="CH: 4" />
                            <TextView style="@style/Badge.Azul" android:layout_marginEnd="4dp" android:text="M: 9" />
                            <TextView style="@style/Badge.Rojo" android:text="G: 3" />
                        </LinearLayout>
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="16" android:textColor="@color/peligro" android:textSize="20sp" android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout style="@style/Tarjeta">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <ImageView android:layout_width="56dp" android:layout_height="56dp" android:background="@drawable/fondo_foto" android:clipToOutline="true" android:contentDescription="Playera polo" android:scaleType="centerCrop" app:srcCompat="@drawable/prod_polo" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView style="@style/TarjetaTitulo" android:text="Playera polo" />
                        <TextView style="@style/TarjetaTexto" android:text="Playeras · Caballero · $189.00" />
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal">
                            <TextView style="@style/Badge.Azul" android:layout_marginEnd="4dp" android:text="CH: 6" />
                            <TextView style="@style/Badge.Azul" android:layout_marginEnd="4dp" android:text="M: 5" />
                            <TextView style="@style/Badge.Azul" android:text="G: 8" />
                        </LinearLayout>
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="19" android:textColor="@color/primario" android:textSize="20sp" android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout style="@style/Tarjeta">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <ImageView android:layout_width="56dp" android:layout_height="56dp" android:background="@drawable/fondo_foto" android:clipToOutline="true" android:contentDescription="Gorra" android:scaleType="centerCrop" app:srcCompat="@drawable/prod_gorra" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView style="@style/TarjetaTitulo" android:text="Gorra" />
                        <TextView style="@style/TarjetaTexto" android:text="Accesorios · Unisex · $99.00" />
                        <TextView style="@style/Badge.Azul" android:layout_marginTop="6dp" android:text="UNI: 30" />
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="30" android:textColor="@color/primario" android:textSize="20sp" android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
