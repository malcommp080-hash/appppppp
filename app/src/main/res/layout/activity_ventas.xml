            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRegistrarVenta"
                style="@style/Boton.Exito"
                android:layout_marginBottom="12dp"
                android:text="＋  Registrar venta" />

            <EditText
                android:id="@+id/editBuscar"
                style="@style/Campo"
                android:drawableStart="@android:drawable/ic_menu_search"
                android:drawablePadding="8dp"
                android:drawableTint="@color/texto_suave"
                android:hint="Buscar por cliente o #folio"
                android:inputType="text" />

            <!-- Venta #24 -->
            <LinearLayout android:id="@+id/venta24" style="@style/Tarjeta">
