                    <TextView style="@style/Monto" android:text="$557.00" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView style="@style/Badge.Azul" android:text="En línea" />
                    <TextView style="@style/TarjetaTexto" android:layout_marginStart="8dp" android:layout_marginTop="0dp" android:text="Depósito / transferencia" />
                </LinearLayout>
