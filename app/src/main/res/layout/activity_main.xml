<?xml version="1.0" encoding="utf-8"?>
<!-- LOGIN: igual que la pantalla de acceso del panel web -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo_login"
    tools:context=".MainActivity">

    <!-- Caja del login (.login-box) -->
    <LinearLayout
        android:id="@+id/cajaLogin"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/fondo_login_caja"
        android:elevation="12dp"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="36dp"
        android:paddingEnd="24dp"
        android:paddingBottom="28dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Logo y nombre (.logo-area) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="30dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imgLogo"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/logo_icono"
                android:clipToOutline="true"
                android:contentDescription="@string/empresa"
                android:scaleType="centerCrop"
                app:srcCompat="@drawable/logo" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/empresa"
                    android:textColor="@color/texto"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/admin"
                    android:textColor="@color/primario"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/txtBienvenido"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bienvenido"
            android:textColor="@color/texto"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="26dp"
            android:text="@string/acceso_panel"
            android:textColor="@color/texto_suave"
            android:textSize="14sp" />

        <TextView
            style="@style/Etiqueta"
            android:layout_marginBottom="8dp"
            android:letterSpacing="0.1"
            android:text="@string/numero_telefono"
            android:textSize="11sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editTelefono"
            style="@style/Campo"
            android:layout_height="50dp"
            android:layout_marginBottom="18dp"
            android:background="@drawable/fondo_input_login"
            android:drawableStart="@android:drawable/ic_menu_myplaces"
            android:drawablePadding="10dp"
            android:drawableTint="@color/texto_suave"
            android:hint="@string/hint_telefono"
            android:inputType="text" />

        <TextView
            style="@style/Etiqueta"
            android:layout_marginBottom="8dp"
            android:letterSpacing="0.1"
            android:text="@string/contrasena"
            android:textSize="11sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editContrasena"
            style="@style/Campo"
            android:layout_height="50dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/fondo_input_login"
            android:drawableStart="@android:drawable/ic_lock_idle_lock"
            android:drawablePadding="10dp"
            android:drawableTint="@color/texto_suave"
            android:hint="@string/hint_contrasena"
            android:inputType="textPassword" />

        <TextView
            android:id="@+id/txtOlvido"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginBottom="14dp"
            android:padding="4dp"
            android:text="@string/olvido_contrasena"
            android:textColor="@color/primario"
            android:textSize="13sp" />

        <!-- Botón con degradado azul (.btn-login) -->
        <Button
            android:id="@+id/btnIniciar"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/btn_login"
            android:text="@string/iniciar_sesion"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:gravity="center"
            android:text="@string/pie_login"
            android:textColor="@color/texto_suave"
            android:textSize="12sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
