<?xml version="1.0" encoding="utf-8"?>
<!-- DASHBOARD: tarjetas de colores, ventas por mes, resumen y últimos registros -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:orientation="vertical"
    tools:context=".Dashboard"
    tools:ignore="HardcodedText">

    <include layout="@layout/barra_superior" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout style="@style/Contenido">

            <TextView style="@style/Titulo" android:text="Dashboard" />
            <TextView style="@style/Subtitulo" android:text="🌤️ ¡Buenas tardes! — Resumen general del sistema" />

            <!-- Tarjetas de estadísticas (.stat-grid) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout android:id="@+id/scClientes" style="@style/Estadistica" android:layout_marginEnd="6dp" android:background="@drawable/sc_teal">
                    <TextView style="@style/EstadisticaValor" android:text="6" />
                    <TextView style="@style/EstadisticaEtiqueta" android:text="Clientes Registrados" />
                    <TextView style="@style/EstadisticaMas" android:text="Ver clientes →" />
                </LinearLayout>

                <LinearLayout android:id="@+id/scVentas" style="@style/Estadistica" android:layout_marginStart="6dp" android:background="@drawable/sc_green">
                    <TextView style="@style/EstadisticaValor" android:text="14" />
                    <TextView style="@style/EstadisticaEtiqueta" android:text="Ventas Totales" />
                    <TextView style="@style/EstadisticaMas" android:text="Ver ventas →" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="16dp"
                android:orientation="horizontal">

                <LinearLayout android:id="@+id/scPrendas" style="@style/Estadistica" android:layout_marginEnd="6dp" android:background="@drawable/sc_amber">
                    <TextView style="@style/EstadisticaValor" android:text="3" />
                    <TextView style="@style/EstadisticaEtiqueta" android:text="Prendas" />
                    <TextView style="@style/EstadisticaMas" android:text="Ver prendas →" />
                </LinearLayout>

                <LinearLayout android:id="@+id/scMonto" style="@style/Estadistica" android:layout_marginStart="6dp" android:background="@drawable/sc_red">
                    <TextView style="@style/EstadisticaValor" android:text="$17,590.15" />
                    <TextView style="@style/EstadisticaEtiqueta" android:text="Monto Total Ventas" />
                    <TextView style="@style/EstadisticaMas" android:text="Más info →" />
                </LinearLayout>
            </LinearLayout>

            <!-- Ventas por mes (gráfica de barras) -->
            <LinearLayout style="@style/Tarjeta">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView style="@style/SeccionTitulo" android:layout_width="0dp" android:layout_weight="1" android:text="📊  Ventas por Mes" />
                    <TextView style="@style/Chip.Activo" android:layout_marginBottom="12dp" android:text="Barras" />
                    <TextView style="@style/Chip" android:layout_marginBottom="12dp" android:text="Línea" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <View android:layout_width="0dp" android:layout_height="43dp" android:layout_marginHorizontal="6dp" android:layout_weight="1" android:background="@drawable/barra_grafica" />
                    <View android:layout_width="0dp" android:layout_height="47dp" android:layout_marginHorizontal="6dp" android:layout_weight="1" android:background="@drawable/barra_grafica" />
                    <View android:layout_width="0dp" android:layout_height="49dp" android:layout_marginHorizontal="6dp" android:layout_weight="1" android:background="@drawable/barra_grafica" />
                    <View android:layout_width="0dp" android:layout_height="93dp" android:layout_marginHorizontal="6dp" android:layout_weight="1" android:background="@drawable/barra_grafica" />
                    <View android:layout_width="0dp" android:layout_height="140dp" android:layout_marginHorizontal="6dp" android:layout_weight="1" android:background="@drawable/barra_grafica" />
                    <View android:layout_width="0dp" android:layout_height="44dp" android:layout_marginHorizontal="6dp" android:layout_weight="1" android:background="@drawable/barra_grafica" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <TextView style="@style/TarjetaTexto" android:layout_width="0dp" android:layout_weight="1" android:gravity="center" android:text="Jun" />
                    <TextView style="@style/TarjetaTexto" android:layout_width="0dp" android:layout_weight="1" android:gravity="center" android:text="Jul" />
                    <TextView style="@style/TarjetaTexto" android:layout_width="0dp" android:layout_weight="1" android:gravity="center" android:text="Ago" />
                    <TextView style="@style/TarjetaTexto" android:layout_width="0dp" android:layout_weight="1" android:gravity="center" android:text="Sep" />
                    <TextView style="@style/TarjetaTexto" android:layout_width="0dp" android:layout_weight="1" android:gravity="center" android:text="Oct" />
                    <TextView style="@style/TarjetaTexto" android:layout_width="0dp" android:layout_weight="1" android:gravity="center" android:text="Nov" />
                </LinearLayout>
            </LinearLayout>

            <!-- Resumen -->
            <LinearLayout style="@style/Tarjeta">

                <TextView style="@style/SeccionTitulo" android:text="🥧  Resumen" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                        <TextView style="@style/TarjetaTexto" android:text="Clientes" android:textSize="10sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="6" android:textColor="@color/primario" android:textSize="20sp" android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                        <TextView style="@style/TarjetaTexto" android:text="Ventas" android:textSize="10sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="14" android:textColor="@color/turquesa" android:textSize="20sp" android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                        <TextView style="@style/TarjetaTexto" android:text="Prendas" android:textSize="10sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="3" android:textColor="@color/amarillo" android:textSize="20sp" android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Últimos 5 clientes (.tcard) -->
            <LinearLayout style="@style/Tarjeta" android:padding="0dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:padding="14dp">
                    <TextView style="@style/SeccionTitulo" android:layout_width="0dp" android:layout_marginBottom="0dp" android:layout_weight="1" android:text="🕒  Últimos 5 Clientes" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnVerClientes" style="@style/Boton" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginTop="0dp" android:text="Ver todos" android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/fondo_tabla_encabezado" android:orientation="horizontal">
                    <TextView style="@style/TablaEncabezado" android:layout_weight="0.5" android:text="ID" />
                    <TextView style="@style/TablaEncabezado" android:text="Nombre" />
                    <TextView style="@style/TablaEncabezado" android:text="Teléfono" />
                </LinearLayout>

                <LinearLayout style="@style/TablaRenglon">
                    <TextView style="@style/TablaCelda" android:layout_weight="0.5" android:text="6" />
                    <TextView style="@style/TablaCelda" android:text="Laura Hernández" />
                    <TextView style="@style/TablaCelda" android:text="5512345678" />
                </LinearLayout>
                <LinearLayout style="@style/TablaRenglon">
                    <TextView style="@style/TablaCelda" android:layout_weight="0.5" android:text="5" />
                    <TextView style="@style/TablaCelda" android:text="Miguel Ramírez" />
                    <TextView style="@style/TablaCelda" android:text="5523456789" />
                </LinearLayout>
                <LinearLayout style="@style/TablaRenglon">
                    <TextView style="@style/TablaCelda" android:layout_weight="0.5" android:text="4" />
                    <TextView style="@style/TablaCelda" android:text="Sofía Torres" />
                    <TextView style="@style/TablaCelda" android:text="5534567890" />
                </LinearLayout>
                <LinearLayout style="@style/TablaRenglon">
                    <TextView style="@style/TablaCelda" android:layout_weight="0.5" android:text="3" />
                    <TextView style="@style/TablaCelda" android:text="Jorge Martínez" />
                    <TextView style="@style/TablaCelda" android:text="5545678901" />
                </LinearLayout>
                <LinearLayout style="@style/TablaRenglon" android:background="@null">
                    <TextView style="@style/TablaCelda" android:layout_weight="0.5" android:text="2" />
                    <TextView style="@style/TablaCelda" android:text="Ana López" />
                    <TextView style="@style/TablaCelda" android:text="5556789012" />
                </LinearLayout>
            </LinearLayout>

            <!-- Últimas 5 ventas -->
            <LinearLayout style="@style/Tarjeta" android:padding="0dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:padding="14dp">
                    <TextView style="@style/SeccionTitulo" android:layout_width="0dp" android:layout_marginBottom="0dp" android:layout_weight="1" android:text="🧾  Últimas 5 Ventas" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnVerVentas" style="@style/Boton.Exito" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginTop="0dp" android:text="Ver todas" android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/fondo_tabla_encabezado" android:orientation="horizontal">
                    <TextView style="@style/TablaEncabezado" android:layout_weight="0.5" android:text="ID" />
                    <TextView style="@style/TablaEncabezado" android:text="Cliente" />
                    <TextView style="@style/TablaEncabezado" android:text="Total" />
                </LinearLayout>

                <LinearLayout style="@style/TablaRenglon">
                    <TextView style="@style/TablaCelda" android:layout_weight="0.5" android:text="#24" />
                    <TextView style="@style/TablaCelda" android:text="Laura Hernández" />
                    <TextView style="@style/TablaCelda" android:text="$557.00" />
                </LinearLayout>
                <LinearLayout style="@style/TablaRenglon">
                    <TextView style="@style/TablaCelda" android:layout_weight="0.5" android:text="#23" />
                    <TextView style="@style/TablaCelda" android:text="Miguel Ramírez" />
                    <TextView style="@style/TablaCelda" android:text="$567.00" />
                </LinearLayout>
                <LinearLayout style="@style/TablaRenglon">
                    <TextView style="@style/TablaCelda" android:layout_weight="0.5" android:text="#22" />
                    <TextView style="@style/TablaCelda" android:text="Sofía Torres" />
                    <TextView style="@style/TablaCelda" android:text="$858.00" />
                </LinearLayout>
                <LinearLayout style="@style/TablaRenglon">
                    <TextView style="@style/TablaCelda" android:layout_weight="0.5" android:text="#21" />
                    <TextView style="@style/TablaCelda" android:text="Jorge Martínez" />
                    <TextView style="@style/TablaCelda" android:text="$698.00" />
                </LinearLayout>
                <LinearLayout style="@style/TablaRenglon" android:background="@null">
                    <TextView style="@style/TablaCelda" android:layout_weight="0.5" android:text="#20" />
                    <TextView style="@style/TablaCelda" android:text="Ana López" />
                    <TextView style="@style/TablaCelda" android:text="$518.00" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
