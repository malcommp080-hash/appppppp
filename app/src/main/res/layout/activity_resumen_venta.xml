<?xml version="1.0" encoding="utf-8"?>
<!-- RESUMEN DE VENTA: detalle de una venta (RF012) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:orientation="vertical"
    tools:context=".ResumenVenta"
    tools:ignore="HardcodedText">

    <include layout="@layout/barra_superior" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout style="@style/Contenido">

            <TextView style="@style/Titulo" android:text="Venta #23" />
            <TextView style="@style/Subtitulo" android:text="02/11/2026 12:15" />

            <!-- Datos de la venta -->
            <LinearLayout style="@style/Tarjeta">
                <TextView style="@style/SeccionTitulo" android:text="🧾  Datos de la venta" />

                <TextView style="@style/Etiqueta" android:layout_marginBottom="2dp" android:text="CLIENTE" android:textSize="11sp" />
                <TextView style="@style/TarjetaTitulo" android:layout_marginBottom="10dp" android:text="Miguel Ramírez · 5523456789" android:textStyle="normal" />

                <TextView style="@style/Etiqueta" android:layout_marginBottom="4dp" android:text="ORIGEN" android:textSize="11sp" />
                <TextView style="@style/Badge.Verde" android:layout_marginBottom="10dp" android:text="Mostrador" />

                <TextView style="@style/Etiqueta" android:layout_marginBottom="2dp" android:text="FORMA DE PAGO" android:textSize="11sp" />
                <TextView style="@style/TarjetaTitulo" android:layout_marginBottom="10dp" android:text="Efectivo" android:textStyle="normal" />

                <TextView style="@style/Etiqueta" android:layout_marginBottom="2dp" android:text="ATENDIÓ" android:textSize="11sp" />
                <TextView style="@style/TarjetaTitulo" android:text="Admin Sistema" android:textStyle="normal" />
            </LinearLayout>

            <!-- Productos (.tcard) -->
            <LinearLayout style="@style/Tarjeta" android:padding="0dp">
                <TextView style="@style/SeccionTitulo" android:layout_margin="14dp" android:text="📦  Productos" android:textColor="@color/texto" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/fondo_tabla_encabezado" android:orientation="horizontal">
                    <TextView style="@style/TablaEncabezado" android:layout_weight="1.4" android:text="Producto" />
                    <TextView style="@style/TablaEncabezado" android:text="Cant." />
                    <TextView style="@style/TablaEncabezado" android:text="Subtotal" />
                </LinearLayout>

                <LinearLayout style="@style/TablaRenglon" android:background="@null">
                    <TextView style="@style/TablaCelda" android:layout_weight="1.4" android:text="Playera polo · G" />
                    <TextView style="@style/TablaCelda" android:text="3 × $189.00" />
                    <TextView style="@style/TablaCelda" android:text="$567.00" />
                </LinearLayout>
            </LinearLayout>

            <!-- Total -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="@drawable/fondo_total"
                android:orientation="horizontal"
                android:padding="14dp">

                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="3 pieza(s)" android:textColor="@color/texto" android:textSize="15sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Total $567.00" android:textColor="@color/texto" android:textSize="15sp" android:textStyle="bold" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton android:id="@+id/btnEliminarVenta" style="@style/Boton.Peligro" android:text="🗑  Eliminar venta" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
